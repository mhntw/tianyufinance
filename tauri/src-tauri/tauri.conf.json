{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "添钰财务管理系统",
  "version": "1.1.1",
  "identifier": "com.chen.xzys",
  "build": {
    "beforeDevCommand": "cd ../ && python3 -m http.server 1420 --bind 127.0.0.1",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": {
      "script": "node scripts/build-dist.mjs",
      "cwd": "../"
    },
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "添钰财务管理系统",
        "width": 1280,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
